# No key needed in demo mode. Switch to llm to use REAL model generation.
APP_MODE=demo
INLINE_WORKER=true
DATABASE_URL=sqlite+aiosqlite:///./data/globex.db
REDIS_URL=
QDRANT_URL=

# OpenAI-compatible tool-calling model; keep keys on the backend only.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
CONTEXT_WINDOW=16000
JOB_TIMEOUT=180

# Embedding endpoint is separate from chat. DeepSeek chat is not an embedding API.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# Optional rerank POST: {model,query,documents,top_n} -> {results:[{index,relevance_score}]}
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=rerank
# Tavily web search; results are restricted to JD/Taobao/Tmall domains by default.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_URL=https://api.tavily.com/search
WEB_SEARCH_API_KEY=
WEB_SEARCH_DOMAINS=jd.com,taobao.com,tmall.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
